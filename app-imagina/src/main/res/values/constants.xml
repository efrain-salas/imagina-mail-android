<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Overrides the ones of Thunderbird (legacy/ui/legacy, IMAGINA.md, «Textos y enlaces»): the User-Agent header
         of the mail the app sends, and the links of the About and Settings screens, which are Imagina's, not
         Thunderbird's or Mozilla's. test/.../ImaginaLinksTest checks that every link of Thunderbird is overridden. -->
    <string name="message_header_mua" translatable="false">Imagina Mail</string>
    <string name="app_webpage_url" translatable="false">https://imagina.build</string>
    <string name="user_forum_url" translatable="false">https://imagina.build</string>
    <string name="app_authors_url" translatable="false">https://github.com/efrain-salas/imagina-mail-android/graphs/contributors</string>
    <string name="app_source_url" translatable="false">https://github.com/efrain-salas/imagina-mail-android</string>
    <!-- Imagina's privacy policy, the only one the app links to (Google Play asks for it in the app too): a row in
         «About» (label about_privacy_policy, in strings.xml) and a link on the sign-in screen -->
    <string name="app_privacy_url" translatable="false">https://imagina.build/privacy</string>
    <!-- The Autocrypt dialog's «click here to learn more» points to K-9 Mail's blog: not shown -->
    <bool name="autocrypt_learn_more_available">false</bool>
    <!-- Imagina Mail asks for no donations and has no funding screen (it has Thunderbird's «no funding» module): the
         link only stays here so that Thunderbird's donation page is not in the app -->
    <string name="funding_url" translatable="false">https://imagina.build</string>
    <!-- Imagina does not support sending from aliases: a mailbox only sends as itself (Migadu refuses any other
         sender for its identities), so no «Manage identities» and the sender address of the composition defaults
         is read only (IMAGINA.md, «Cambios en ficheros de Thunderbird») -->
    <bool name="sender_addresses_editable">false</bool>
    <!-- The signature of each mailbox is Imagina's: it comes with the mailbox from the devices API and the person
         changes it in «Mi cuenta», so in the composition defaults it is read only, with a note that says so
         (signature_managed_notice, in strings.xml; IMAGINA.md, «Cambios en ficheros de Thunderbird») -->
    <bool name="signature_editable">false</bool>
    <!-- The typefaces of Imagina's design system that the app bundles (res/font, imagina/brand/fonts/OFL.txt), in the
         libraries of «About» (IMAGINA.md, «Tipografía») -->
    <!-- No IMAP push from the phone: new mail comes with Imagina's notices (IMAGINA.md, «Notificaciones»), so the
         folder settings do not offer it and the manifest drops the push service, its foreground types and exact alarms -->
    <bool name="folder_push_available">false</bool>
    <string-array name="about_extra_libraries" translatable="false">
        <item>Fraunces|https://github.com/undercasetype/Fraunces|SIL Open Font License 1.1</item>
        <item>Instrument Sans|https://github.com/Instrument/instrument-sans|SIL Open Font License 1.1</item>
    </string-array>
</resources>
