<?xml version="1.0" encoding="utf-8"?>
<!--
    Instrument Sans where Material asks for its «brand» typeface (the title of a toolbar or a dialog): the normal
    style is the semibold weight, and bold is the real bold. See imagina_typography.xml.
-->
<font-family
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <font
        android:font="@font/instrument_sans_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/instrument_sans_semibold"
        app:fontStyle="normal"
        app:fontWeight="600"
        />
    <font
        android:font="@font/instrument_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/instrument_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700"
        />
</font-family>
